REPORTING_APP_NAME=Telecom Reporting Backend
REPORTING_ENVIRONMENT=local
REPORTING_DEBUG=false
REPORTING_HOST=127.0.0.1
REPORTING_PORT=8001
REPORTING_API_PREFIX=/api/v1
ML_RUNS_ROOT=../ML_backend/runs
# ML_REGISTRY_ROOT=../ML_backend/run_registry
REPORT_OUTPUT_ROOT=./report_outputs
DEFAULT_FILE_ENCODING=utf-8
